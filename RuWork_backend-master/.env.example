# Runtime environment. Set to "production" in a deployed environment: it enables HSTS,
# stricter startup validation, JSON log output, and disables the test-only fallbacks.
NODE_ENV=development
PORT=5000

# Required in every environment. Startup fails fast if either is missing.
# JWT_SECRET must be at least 32 characters in production. Never commit real values.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Browser client origin used for verification/reset links and as the default CORS origin.
CLIENT_URL=http://localhost:5173
# Optional comma-separated CORS allowlist. Falls back to CLIENT_URL. A wildcard is rejected
# in production. Every entry must include an http or https scheme.
CORS_ORIGINS=

# Set when the API runs behind a reverse proxy or load balancer so rate limiting sees the
# real client IP. Accepts "true", "false", or a number of trusted hops.
TRUST_PROXY=false
# Maximum accepted JSON request body.
JSON_BODY_LIMIT=100kb
# Emergency switch only; leave unset so rate limiting stays enabled.
RATE_LIMIT_DISABLED=

ALLOWED_STUDENT_EMAIL_DOMAIN=ruh.ac.lk

# SMTP delivery. All four of HOST/USER/PASSWORD/FROM are required in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

EMAIL_VERIFICATION_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Password reset token lifetime and per-account request cooldown.
PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Used only by `npm run create-admin` to provision the first Admin privately.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used only by `npm run seed:demo` outside production.
DEMO_PASSWORD=
